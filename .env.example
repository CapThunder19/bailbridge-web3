# Copy to .env (never commit .env). Values shown are examples only.

# ---- Contracts / deployment ----
# Sepolia deployment (leave empty for local Hardhat development)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Public RPC the browser uses to read the contract (verify / release-clock)
PUBLIC_RPC_URL=
EXPLORER_URL=

# Role addresses granted at deploy time (comma-separated lists allowed).
# On localhost these default to Hardhat accounts #0 (admin+registrar), #1 lawyer, #2 issuer, #3 prison.
ADMIN_ADDRESS=
REGISTRAR_ADDRESS=
LAWYER_ADDRESSES=
ISSUER_ADDRESSES=
PRISON_ADDRESSES=
