# Copy to .env (never commit .env). Values shown are examples only.

# ---- Contracts / deployment ----
# Sepolia deployment (leave empty for local Hardhat development)
SEPOLIA_RPC_URL=
DEPLOYER_PRIVATE_KEY=
# Public RPC the browser uses to read the contract (verify / release-clock)
PUBLIC_RPC_URL=
EXPLORER_URL=

# Role addresses granted at deploy time (comma-separated lists allowed).
# On localhost these default to Hardhat accounts #0 (admin+registrar), #1 lawyer, #2 issuer, #3 prison.
ADMIN_ADDRESS=
REGISTRAR_ADDRESS=
LAWYER_ADDRESSES=
ISSUER_ADDRESSES=
PRISON_ADDRESSES=

# ---- Server ----
PORT=4000
# Required in production: secret mixed into every on-chain commitment (keep it private and stable).
COMMITMENT_SECRET=
# Password for all seeded demo accounts (caseworker, lawyer, issuer, prison).
DEMO_PASSWORD=bailbridge-demo
# Public URL of the web app (used in the QR code printed on order PDFs).
PUBLIC_WEB_URL=http://localhost:5173
# Set to "true" behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Optional overrides
DB_PATH=
STORAGE_DIR=
DEPLOYMENT_FILE=

# Chain mode (server). On a local Hardhat chain these default automatically.
# RPC the server uses to send registrar txs and verify wallet txs.
RPC_URL=
# Registrar wallet key (holds REGISTRAR_ROLE; needs test ETH on Sepolia). Never commit.
REGISTRAR_PRIVATE_KEY=
# Force off-chain demo mode even if a deployment exists.
CHAIN_DISABLED=false

# Wallets mapped to demo users (default: deployment roles, or Hardhat accounts #1-#3 locally).
DEMO_LAWYER_WALLET=
DEMO_ISSUER_WALLET=
DEMO_PRISON_WALLET=

# ---- AI (optional) ----
# Without a key the server uses a deterministic advisory summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
